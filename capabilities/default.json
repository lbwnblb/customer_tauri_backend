{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["https://*.jinritemai.com/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-add-shop-channel",
    "allow-start-backend-channel",
    "allow-shop-account",
    "allow-add-shop",
    "allow-delete-shop",
    "allow-shop-list",
    "allow-select-shop",
    "allow-select-platform",
    "allow-greet",
    "allow-on-request",
    "allow-on-ws",
    "allow-on-ws-binary",
    "allow-dy-ws-recv",
    "allow-dy-ws-send",
    "allow-on-http-response-intercepted",
    "allow-shop-name-callback",
    "allow-on-get-link-info",
    "allow-pdd-ws-recv",
    "allow-pdd-ws-send",
    "allow-pdd-send-message",
    "allow-check-token",
    "allow-on-login-success",
    "allow-on-logout"
  ]
}