{
  "identifier": "douyin-remote",
  "webviews": ["08_douyin_*"],
  "remote": {
    "urls": [
      "https://im.jinritemai.com/*",
      "https://fxg.jinritemai.com/*",
      "https://*.jinritemai.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-add-shop-channel",
    "allow-on-request",
    "allow-on-ws",
    "allow-dy-ws-recv",
    "allow-dy-ws-send",
    "allow-on-http-response-intercepted",
    "allow-shop-name-callback",
    "allow-on-get-link-info"
  ]
}